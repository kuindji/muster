{
  "name": "@kuindji/muster-contract",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fixtures/golden-hashes.json": "./fixtures/golden-hashes.json",
    "./fixtures/jcs-rfc8785.json": "./fixtures/jcs-rfc8785.json",
    "./fixtures/lifecycle-fixtures.json": "./fixtures/lifecycle-fixtures.json",
    "./fixtures/prompt-injection.json": "./fixtures/prompt-injection.json",
    "./fixtures/schema-conformance.json": "./fixtures/schema-conformance.json",
    "./fixtures/store-concurrency-cases.json": "./fixtures/store-concurrency-cases.json"
  },
  "files": ["dist", "fixtures/*.json"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "fixtures:check": "node fixtures/generate.mjs --check",
    "fixtures:generate": "node fixtures/generate.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22",
    "canonicalize": "^2.1.0",
    "typescript": "^5.9.2"
  }
}
